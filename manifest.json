{
  "manifest_version": 3,
  "name": "抖音推荐流过滤器",
  "version": "0.2.0",
  "description": "按发布日期和关键字自动跳过抖音网页版首页推荐流的视频",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "抖音推荐流过滤器"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
